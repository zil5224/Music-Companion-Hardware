# Windows 首次配置且 .env 不存在时，运行 Copy-Item .env.example .env。
# 真实 .env 留在本机，公开时只上传 .env.example。

# 使用自己申请的 API Key。Key 仅由本机服务端读取。
DEEPSEEK_API_KEY=
# 填账号可调用的模型 ID。千问示例为 deepseek-v4-pro，服务端默认 deepseek-chat。
DEEPSEEK_MODEL=
# 填 Key 签发平台提供的基础地址，保留版本路径。服务端会追加 /chat/completions。
# 千问按量计费示例为 https://maas.qianwenaiapi.com/compatible-mode/v1。
# 服务端默认 https://api.deepseek.com/v1。
DEEPSEEK_BASE_URL=

# 本机网页监听地址和端口。留空时分别使用 127.0.0.1 和 8080。
ZILY_HOST=
ZILY_PORT=
# npm start 启动的网易云音乐服务端口。未配置时使用 3000。
# NCM_PORT=3000
# 可选的独立网易云临时目录，建议填写绝对路径。
# ZILY_NCM_TEMP_DIR=
# 本机网易云音乐服务地址。修改 NCM_PORT 时同步设置此地址。
NCM_API_URL=

# 自动备份可选配置。按需取消对应行的注释并填写。
# ZILY_BACKUP_ENABLED=
# ZILY_BACKUP_DIR=
# ZILY_BACKUP_INTERVAL_HOURS=
# ZILY_BACKUP_RETENTION=
