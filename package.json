{
  "name": "music-companion",
  "version": "1.1.0",
  "description": "An AI-powered music companion with an STM32 OLED/encoder hardware terminal: streaming chat, music discovery, intelligent playlists, long-term memory and a Web Serial device link.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "server": "node server/server.js",
    "ncm": "node scripts/ncm.js",
    "check": "node scripts/check-syntax.cjs",
    "test": "node --test"
  },
  "dependencies": {
    "NeteaseCloudMusicApi": "^4.32.0"
  },
  "overrides": {
    "NeteaseCloudMusicApi": {
      "pac-proxy-agent": {
        "get-uri": {
          "basic-ftp": "6.2.6"
        }
      },
      "music-metadata": "11.16.1"
    }
  }
}